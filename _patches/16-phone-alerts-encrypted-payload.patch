+        chunk = plaintext[off:off + 16]
+        ct += bytes(a ^ b for a, b in zip(chunk, ks))
+        counter += 1
+    g = 0
+    padded = bytes(ct) + bytes(-len(ct) % 16)
+    for off in range(0, len(padded), 16):
+        g = _gf128_mul(g ^ int.from_bytes(padded[off:off + 16], "big"), h)
