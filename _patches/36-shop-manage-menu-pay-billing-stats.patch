+{% extends "base.html" %}
+{% block title %}Stats - OpsHub{% endblock %}
+{% block content %}
+<h4 class="mb-3"><i class="bi bi-bar-chart-line"></i> Shop Stats <span class="text-muted fs-6">- {{ period_label }}</span></h4>
+{% set period_endpoint = 'shop_stats' %}{% include "_shop_period.html" %}
+
+<div class="row g-2 mb-3">
+  {% set margin = parts_sale - parts_cost %}
+  {% for label, value, sub in [
+      ('Labor Hours', '%.1f'|format(labor.h), (labor.n ~ ' sessions, ' ~ labor.people ~ ' laborer' ~ ('s' if labor.people != 1 else ''))),
+      ('Labor $', '$' ~ '%.2f'|format(labor.c), 'at clock-in rates'),
+      ('Parts Billed', '$' ~ '%.2f'|format(parts_sale), 'cost $' ~ '%.2f'|format(parts_cost)),
+      ('Parts Margin', '$' ~ '%.2f'|format(margin), (('%.0f'|format(margin / parts_sale * 100)) ~ '% of sale') if parts_sale else '-'),
+      ('Projects Worked', projects_worked, 'labor or parts this period'),
+      ('Total Billed', '$' ~ '%.2f'|format(labor.c + parts_sale), 'parts + labor') ] %}
+  <div class="col-6 col-md-4 col-xl-2">
+    <div class="card p-3 h-100">
+      <div class="text-muted small">{{ label }}</div>
+      <div class="fs-4 fw-bold">{{ value }}</div>
+      <div class="small text-muted">{{ sub }}</div>
+    </div>
+  </div>
+  {% endfor %}
+</div>
+
+<div class="row g-3">
+  <div class="col-lg-4">
+    <div class="card p-3 h-100">
