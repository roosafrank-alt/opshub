+{% extends "base.html" %}
+{% block title %}Billing - OpsHub{% endblock %}
+{% block content %}
+<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
+  <h4 class="mb-0"><i class="bi bi-receipt"></i> Billing <span class="text-muted fs-6">- {{ period_label }}, by project</span></h4>
+  <div class="text-end">
+    <span class="text-muted small d-block">Parts ${{ '%.2f'|format(totals.parts) }} + Labor ${{ '%.2f'|format(totals.labor) }}</span>
+    <strong class="fs-4">${{ '%.2f'|format(totals.total) }}</strong>
+  </div>
+</div>
+{% set period_endpoint = 'shop_billing' %}{% include "_shop_period.html" %}
+
+{% if projects %}
+<div class="card">
+  <div class="table-responsive">
+    <table class="table table-sm align-middle mb-0 table-stack">
+      <thead class="table-light"><tr><th>Project</th><th>Aircraft</th><th>Status</th><th>Parts (sale)</th><th>Labor</th><th>Total</th><th></th></tr></thead>
+      <tbody>
+        {% for p in projects %}
+        <tr>
+          <td class="stack-full" data-label="Project"><a href="{{ url_for('project_detail', project_id=p.id) }}"><strong>{{ p.code }}</strong></a> <small class="text-muted">{{ p.name }}</small></td>
+          <td data-label="Aircraft">{{ p.asset_tag or '-' }}</td>
+          <td data-label="Status"><span class="badge {{ 'bg-success' if p.status == 'completed' else ('bg-primary' if p.status == 'active' else 'bg-secondary') }}">{{ (p.status or '-')|replace('_', ' ')|title }}</span></td>
+          <td data-label="Parts (sale)">${{ '%.2f'|format(p.parts) }}{% if p.parts_count %} <small class="text-muted">({{ p.parts_count }} part{{ 's' if p.parts_count != 1 }})</small>{% endif %}</td>
+          <td data-label="Labor">${{ '%.2f'|format(p.labor) }} <small class="text-muted">({{ '%.1f'|format(p.labor_hours) }} hr)</small></td>
+          <td data-label="Total"><strong>${{ '%.2f'|format(p.total) }}</strong></td>
+          <td class="text-end"><a href="{{ url_for('project_invoice_csv', project_id=p.id) }}" class="btn btn-sm btn-outline-success text-nowrap" title="Customer invoice (whole project, all dates)"><i class="bi bi-download"></i> Invoice</a></td>
+        </tr>
+        {% endfor %}
+      </tbody>
+      <tfoot class="table-light fw-bold"><tr><td colspan="3">Total</td><td>${{ '%.2f'|format(totals.parts) }}</td><td>${{ '%.2f'|format(totals.labor) }} <small class="text-muted fw-normal">({{ '%.1f'|format(totals.labor_hours) }} hr)</small></td><td>${{ '%.2f'|format(totals.total) }}</td><td></td></tr></tfoot>
+    </table>
+  </div>
+</div>
+<p class="small text-muted mt-2 mb-0">Parts are billed at sell price (your cost for them in this period: ${{ '%.2f'|format(totals.parts_cost) }}). Labor is clocked time at each laborer's rate when they clocked in. The Invoice button downloads the full customer invoice for that project, covering all dates.</p>
+{% else %}
+<p class="text-muted">No parts used or labor clocked on any project in this period.</p>
+{% endif %}
+{% endblock %}
