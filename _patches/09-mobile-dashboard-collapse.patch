diff --git a/templates/flight/dashboard.html b/templates/flight/dashboard.html
index 93c415f..73bed7f 100644
--- a/templates/flight/dashboard.html
+++ b/templates/flight/dashboard.html
@@ -3,6 +3,18 @@
 {% block content %}
 <style>
   .today-row-clickable:hover { background-color: rgba(255, 193, 7, 0.12); }
+  /* Phones: Today's Schedule, Upcoming and Recent Flights start collapsed
+     to just their header (with a count) - tap the header to open. Wider
+     screens always show them open and the chevron/count stay hidden. */
+  .dash-chevron, .dash-count { display: none; }
+  @media (max-width: 575.98px) {
+    .dash-chevron { display: inline-block; transition: transform .15s ease; }
+    .dash-count { display: inline-block; }
+    .dash-collapsible.is-open .dash-chevron { transform: rotate(90deg); }
+    .dash-collapse-head { cursor: pointer; -webkit-user-select: none; user-select: none; min-height: 32px; }
+    .dash-collapsible:not(.is-open) .dash-collapse-head { margin-bottom: 0 !important; }
+    .dash-collapsible:not(.is-open) .dash-collapse-body { display: none; }
+  }
   .wx-tile { color: #fff; transition: background .3s ease; position: relative; overflow: hidden; }
   .wx-content { position: relative; z-index: 1; }
   .wx-bg-icon { position: absolute; top: -0.5rem; right: -0.5rem; font-size: 7rem; opacity: .22; z-index: 0; pointer-events: none; line-height: 1; filter: drop-shadow(0 2px 4px rgba(0,0,0,.15)); }
@@ -213,6 +225,26 @@
 
 {% block scripts %}
 <script>
+// Which collapsible dashboard sections are open on this phone. Kept in a
+// variable (plus sessionStorage when allowed) and re-applied after every
+// live refresh, since the refresh replaces the sections' HTML.
+var dashOpen = {};
+try { dashOpen = JSON.parse(sessionStorage.getItem('opshub-dash-open') || '{}') || {}; } catch (e) { dashOpen = {}; }
+function applyDashCollapse() {
+  document.querySelectorAll('.dash-collapsible').forEach(function (card) {
+    card.classList.toggle('is-open', !!dashOpen[card.getAttribute('data-dash-key')]);
+  });
+}
+applyDashCollapse();
+document.addEventListener('click', function (evt) {
+  var head = evt.target.closest('[data-dash-toggle]');
+  if (!head || evt.target.closest('a, button, form')) return; // let "Full Calendar" etc. work normally
+  if (!window.matchMedia('(max-width: 575.98px)').matches) return;
+  var key = head.getAttribute('data-dash-toggle');
+  dashOpen[key] = !dashOpen[key];
+  try { sessionStorage.setItem('opshub-dash-open', JSON.stringify(dashOpen)); } catch (e) {}
+  applyDashCollapse();
+});
 (function () {
   var region = document.getElementById('dashboard-live-region');
   if (!region) return;
@@ -225,7 +257,7 @@
     inFlight = true;
     fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' })
       .then(function (resp) { return resp.ok ? resp.text() : null; })
-      .then(function (html) { if (html !== null) region.innerHTML = html; })
+      .then(function (html) { if (html !== null) { region.innerHTML = html; applyDashCollapse(); } })
       .catch(function () { /* network hiccup - just try again next tick */ })
       .finally(function () { inFlight = false; });
   }
