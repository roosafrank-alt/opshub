+// Tap feedback for Acknowledge / ETA: the tapped button shows "Saving..."
+// right away and the form's buttons lock so a second tap can't double-post.
+// The tapped button's name/value (eta_minutes) is copied into a hidden
+// field first, since disabled buttons aren't sent with the form.
+document.addEventListener('submit', function (e) {
+  var form = e.target;
+  if (!form.matches || !form.matches('.session-overdue-banner form, .session-eta-box form')) return;
+  var btn = e.submitter;
+  if (btn && btn.name) {
+    var h = document.createElement('input');
+    h.type = 'hidden'; h.name = btn.name; h.value = btn.value;
+    form.appendChild(h);
+  }
+  setTimeout(function () {
+    form.querySelectorAll('button').forEach(function (b) { b.disabled = true; });
+    if (btn) btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Saving...';
+  }, 0);
+});
+
