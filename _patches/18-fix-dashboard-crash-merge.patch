+
+/* Flight chips: a compact, clickable box per flight used on the flight
+   dashboard's per-day schedule (_dashboard_live.html) and the Schedule
+   calendar's List view (_schedule_live.html). Status is carried by the
+   whole box's color plus a small corner icon - open circle (scheduled),
+   a wavy line (in progress), filled check (complete) - instead of a text
+   badge, so a glance at the color/shape tells you the status without
+   reading anything. Clicking a chip reveals more (see the flight-chip
+   variant's own JS: dashboard.html's delegated handler toggles
+   .flight-chip-detail; the Schedule calendar's chips instead reuse the
+   existing .schedule-block click handler/detail modal). */
+.flight-chip {
+  position: relative;
+  display: inline-flex;
+  align-items: flex-start;
+  gap: .4rem;
+  min-width: 5.5rem;
+  padding: .35rem 1.4rem .35rem .5rem;
+  border-radius: .5rem;
+  cursor: pointer;
+  transition: box-shadow .15s ease;
+}
+.flight-chip:hover { box-shadow: 0 0 0 2px rgba(0,0,0,.08); }
+.flight-chip.flight-chip-open { box-shadow: 0 0 0 2px rgba(0,0,0,.18); }
+.flight-chip-icon { position: absolute; top: .35rem; right: .4rem; font-size: .68rem; }
+.flight-chip-student { font-weight: 600; font-size: .82rem; line-height: 1.15; }
+.flight-chip-plane { font-size: .74rem; color: #495057; line-height: 1.15; }
+.flight-chip-day { font-weight: 700; font-size: .82rem; margin-right: .15rem; }
+.flight-chip-detail { margin-top: .35rem; padding-top: .35rem; border-top: 1px dashed rgba(0,0,0,.18); font-size: .74rem; min-width: 8rem; }
+.flight-chip-time { font-size: .78rem; font-weight: 700; color: #495057; padding-top: .45rem; min-width: 3.4rem; }
+/* Same-time flights render as a grid, one column per plane in the fleet
+   (see plane_lane/plane_color in _dashboard_context()) - each chip is
+   placed in its plane's own column via an inline grid-column style, so a
+   given plane always lands in the same visual slot instead of shifting
+   around based on whichever flight sorts first that moment. */
+.flight-chip-grid { display: grid; gap: .5rem; flex: 1 1 auto; min-width: 0; }
+
+.flight-chip-scheduled { background: #e7f1ff; border: 1px solid #b6d4fe; }
+.flight-chip-scheduled .flight-chip-icon { color: #0d6efd; }
+.flight-chip-in_progress { background: #fff8e1; border: 1px solid #ffe69c; animation: flight-chip-pulse 1.8s ease-in-out infinite; }
+.flight-chip-in_progress .flight-chip-icon { color: #dc9b00; }
+.flight-chip-completed { background: #eaf7ee; border: 1px solid #b6e2c1; opacity: .85; }
+.flight-chip-completed .flight-chip-icon { color: #198754; }
+@keyframes flight-chip-pulse {
+  0%, 100% { box-shadow: 0 0 3px rgba(255,193,7,.5); }
+  50% { box-shadow: 0 0 8px rgba(255,193,7,.9); }
+}
+@media (prefers-reduced-motion: reduce) {
+  .flight-chip-in_progress { animation: none; }
+}
+@media (max-width: 575.98px) {
+  .flight-chip { min-width: 4.6rem; padding: .3rem 1.25rem .3rem .4rem; }
+  .flight-chip-student, .flight-chip-day { font-size: .76rem; }
+  .flight-chip-plane { font-size: .68rem; }
+}
+
+/* Dashboard section collapse - Today's Schedule / Upcoming / Recent Flights
+   each start closed (see the "hidden" .dash-collapse-body in
+   _dashboard_live.html) so the dashboard loads as a compact stack of
+   headers+badges, and clicking a header reveals its full list. The chevron
+   rotates to point down while open (see dashboard.html's click handler,
+   which toggles the "open" class alongside the body's hidden attribute). */
+.dash-collapse-toggle { cursor: pointer; }
+.dash-collapse-toggle:hover h6 { text-decoration: underline; }
+.dash-collapse-chevron { transition: transform .15s ease; color: #6c757d; }
+.dash-collapse-toggle.open .dash-collapse-chevron { transform: rotate(90deg); }
+
+/* Admin error log - each error is one clickable row (see
+   templates/admin_system_log.html); clicking reveals its full traceback in
+   the row directly below instead of always showing every traceback at
+   once. */
+.error-log-row { cursor: pointer; }
+.error-log-chevron { transition: transform .15s ease; color: #6c757d; }
+.error-log-row.error-log-row-open .error-log-chevron { transform: rotate(90deg); }
+.error-log-detail-row td { border-top: none; }
