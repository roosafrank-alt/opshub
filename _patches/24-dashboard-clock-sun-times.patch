-</h4>
+{#
+  Header row: welcome on the left; on the right a compact time box -
+  day/date, live local + Zulu clocks (ticked in the browser, see the
+  dash-clock script below) and today's sunrise/sunset + civil twilight at
+  N89 (sun.py, worked out locally so it shows for every login). Wraps
+  under the welcome on a phone.
+#}
+<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
+  <h4 class="mb-0">
+    {% if cfi %}Welcome, {{ cfi.name }}{% elif student and student.is_station %}{{ student.name }}{% else %}Welcome, {{ student.name }}{% endif %}
+  </h4>
+  <div class="dash-timebox" id="dash-timebox">
+    <div class="dash-timebox-row">
+      <span class="fw-bold" id="dash-clock-date">{{ sun_times.date if sun_times else '' }}</span>
+      <span><span class="dash-timebox-label">Local</span> <span class="fw-bold font-monospace" id="dash-clock-local">--:--</span></span>
+      <span><span class="dash-timebox-label">Zulu</span> <span class="fw-bold font-monospace" id="dash-clock-zulu">--:--Z</span></span>
+    </div>
+    {% if sun_times %}
+    <div class="dash-timebox-row dash-timebox-sun">
+      <span title="Civil twilight begins {{ sun_times.civil_begin_z }}"><i class="bi bi-brightness-alt-high"></i> Civil {{ sun_times.civil_begin or '-' }}</span>
+      <span title="Sunrise {{ sun_times.sunrise_z }}"><i class="bi bi-sunrise"></i> {{ sun_times.sunrise or '-' }}</span>
+      <span title="Sunset {{ sun_times.sunset_z }}"><i class="bi bi-sunset"></i> {{ sun_times.sunset or '-' }}</span>
+      <span title="Civil twilight ends {{ sun_times.civil_end_z }}"><i class="bi bi-moon-stars"></i> Civil {{ sun_times.civil_end or '-' }}</span>
+    </div>
+    {% endif %}
+  </div>
+</div>
+<style>
+  .dash-timebox { background: var(--bs-body-bg, #fff); border: 1px solid rgba(0,0,0,.125); border-radius: .5rem;
+                  padding: .35rem .7rem; font-size: .82rem; line-height: 1.5; }
+  .dash-timebox-row { display: flex; flex-wrap: wrap; column-gap: .9rem; row-gap: .1rem; }
+  .dash-timebox-label { color: #6c757d; font-size: .72rem; text-transform: uppercase; letter-spacing: .03em; }
+  .dash-timebox-sun { color: #495057; }
+  .dash-timebox-sun .bi { color: #dc9b00; }
+  @media (max-width: 575.98px) { .dash-timebox { width: 100%; font-size: .78rem; } }
+</style>
+<script>
+  // Live day/date + local and Zulu clocks for the header time box. Local
+  // is shown in the school's time zone (America/New_York, same as the
+  // weather card) whatever the viewing device is set to.
+  (function () {
+    var tz = "America/New_York";
+    var d = document.getElementById("dash-clock-date");
+    var l = document.getElementById("dash-clock-local");
+    var z = document.getElementById("dash-clock-zulu");
+    if (!l || !z) return;
+    function pad(n) { return (n < 10 ? "0" : "") + n; }
+    function tick() {
+      var now = new Date();
+      try {
+        d.textContent = now.toLocaleDateString("en-US", { timeZone: tz, weekday: "long", month: "short", day: "numeric", year: "numeric" });
+        l.textContent = now.toLocaleTimeString("en-US", { timeZone: tz, hour: "numeric", minute: "2-digit" });
+      } catch (e) {
+        d.textContent = now.toDateString();
+        l.textContent = now.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
+      }
+      z.textContent = pad(now.getUTCHours()) + pad(now.getUTCMinutes()) + "Z";
+    }
+    tick();
+    setInterval(tick, 15000);
+  })();
+</script>
 {% if student and student.is_station %}
 <p class="text-muted small mt-n2 mb-3"><i class="bi bi-info-circle"></i> Station account - use Schedule below to book time on a plane.</p>
