           </td>
           <td data-label="Username"><code>{{ s.username }}</code></td>
           <td data-label="Instructor Rate"><a href="{{ url_for('flight.student_field_detail', student_id=s.id, field_key='instructor_rate') }}" class="text-decoration-none" title="View / edit / history">{% if s.rate_override is not none %}${{ '%.2f'|format(s.rate_override) }}/hr{% else %}<span class="text-muted">CFI's rate</span>{% endif %}</a></td>
