+// Just-booked flight(s) (?new=ids from Schedule Flight): bring the first
+// one into view, then drop the green outline on the first click anywhere
+// or when leaving the page. The `new` param is taken out of the address
+// (so the live refresh, a reload, or coming Back doesn't bring it back).
+(function () {
+  if (!/[?&]new=/.test(window.location.search)) return;
+  var first = document.querySelector('.schedule-block-new');
+  if (first && !document.querySelector('.schedule-block-highlight')) {
+    setTimeout(function () { first.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 50);
+  }
+  function stripParam() {
+    try {
+      var u = new URL(window.location.href);
+      if (!u.searchParams.has('new')) return;
+      u.searchParams.delete('new');
+      window.history.replaceState(window.history.state, '', u.pathname + (u.search ? u.search : '') + u.hash);
+    } catch (e) { /* old browser - the outline still clears below */ }
+  }
+  function clearNew() {
+    document.querySelectorAll('.schedule-block-new').forEach(function (el) { el.classList.remove('schedule-block-new'); });
+    stripParam();
+  }
+  document.addEventListener('click', clearNew, { capture: true, once: true });
+  window.addEventListener('pagehide', stripParam);
+  window.addEventListener('pageshow', function (e) { if (e.persisted) clearNew(); });
+})();
