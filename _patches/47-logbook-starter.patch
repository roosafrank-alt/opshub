+  <a href="{{ url_for('logbook.logbook_list', asset_id=asset.id) }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-search"></i> Search</a>
+</div>
+
+<ul class="nav nav-tabs mb-2">
