+{% extends "base.html" %}
+{% block title %}Logbook Templates - OpsHub{% endblock %}
+{% block content %}
+<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
+  <h4 class="mb-0"><i class="bi bi-file-earmark-text"></i> Logbook Templates</h4>
+  <a href="{{ url_for('logbook.logbook_list') }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-journal-text"></i> Logbook</a>
+</div>
+<div class="card p-3 mb-3 small">
+  <p class="mb-1">These are the wording for the <strong>combined project entry</strong> on a project's Logbook Starter, one per type of project and logbook. Type or paste your own, or upload a .txt file. Blank = the built-in wording.</p>
+  <p class="mb-1">These fill in automatically:</p>
+  <div class="d-flex flex-wrap gap-1">
+    {% for ph, what in placeholders %}<span class="badge bg-light text-dark border"><code>{{ ph }}</code> {{ what }}</span>{% endfor %}
+  </div>
+</div>
+
+{% set ns = namespace(pt=None) %}
+{% for t in templates %}
+  {% if t.project_type != ns.pt %}{% set ns.pt = t.project_type %}<h5 class="mt-3">{{ t.project_label }}</h5>{% endif %}
+  <form method="post" enctype="multipart/form-data" class="card p-3 mb-2" id="t-{{ t.project_type }}-{{ t.log_type }}">
+    <input type="hidden" name="project_type" value="{{ t.project_type }}">
+    <input type="hidden" name="log_type" value="{{ t.log_type }}">
+    <div class="d-flex justify-content-between align-items-center mb-1">
+      <strong>{{ t.log_label }} log</strong>
+      <span class="badge {{ 'bg-success' if t.custom else 'bg-secondary' }}">{{ 'Your template' if t.custom else 'Built-in' }}</span>
+    </div>
+    <textarea name="body" rows="{{ [t.body.count('\n') + 2, 12]|min }}" class="form-control" style="font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size:.8rem;">{{ t.body }}</textarea>
+    <div class="d-flex gap-2 mt-2 flex-wrap align-items-center">
+      <button class="btn btn-success btn-sm" name="action" value="save"><i class="bi bi-check-lg"></i> Save</button>
+      <input type="file" name="file" accept=".txt,text/plain" class="form-control form-control-sm" style="max-width:260px;" onchange="if(this.files.length) this.form.submit()">
+      {% if t.custom %}<button class="btn btn-outline-secondary btn-sm" name="action" value="reset"><i class="bi bi-arrow-counterclockwise"></i> Use built-in</button>{% endif %}
+    </div>
+  </form>
+{% endfor %}
+{% endblock %}
