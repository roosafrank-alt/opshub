+  .lb-year { font-size: .75rem; font-weight: 700; color: #6c757d; text-transform: uppercase; letter-spacing: .05em; margin: .75rem 0 .25rem; }
+</style>
+<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
