+                          _parse_hours(request.form.get("tach")), _parse_hours(request.form.get("hobbs")),
+                          (request.form.get("signed_by") or "").strip() or None,
+                          (request.form.get("cert_number") or "").strip() or None, now_iso(), entry_id))
