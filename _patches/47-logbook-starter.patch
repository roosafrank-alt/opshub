+    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="lbCopy(this)"><i class="bi bi-clipboard"></i> Copy</button>
+  </div>
+</form>
+{% endmacro %}
+
+<div class="row g-3">
+  <div class="col-lg-6">
+    <h5>Sub area entries <small class="text-muted fs-6">(one per sub area, with its endorsement)</small></h5>
+    {% for s in section_starters %}
+      {{ starter_card(s.body, s.log_type, s.section, s.section, s.part_count ~ ' part' ~ ('s' if s.part_count != 1 else '')) }}
+    {% else %}
+      <p class="text-muted">No sub areas or parts on this project yet. Add a sub area or scan parts in, and they'll show up here.</p>
+    {% endfor %}
+  </div>
+  <div class="col-lg-6">
+    <h5>Combined project entry <small class="text-muted fs-6">({{ dict(project_types)[project_type] }} template)</small></h5>
+    {% for c in combined %}
+      {{ starter_card(c.body, c.log_type, None, log_type_labels[c.log_type] ~ ' log', 'your template' if c.custom_template else 'built-in template') }}
+    {% endfor %}
+    {% if session.get('is_master_admin') or session.get('shop_role') == 'admin' %}
+    <p class="small text-muted"><a href="{{ url_for('logbook.logbook_templates') }}"><i class="bi bi-file-earmark-text"></i> Edit or upload the templates</a></p>
+    {% endif %}
+  </div>
+</div>
+
+<div class="card p-3 mt-2">
+  <h5 class="mb-2">Saved entries for this project</h5>
+  {% if saved %}
+  <div class="list-group list-group-flush">
+    {% for e in saved %}
+    <div class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2 flex-wrap">
+      <div class="small"><strong>{{ e.entry_date|usdate }}</strong> &middot; <span class="badge bg-light text-dark border">{{ log_type_labels[e.log_type] }}</span>
+        {{ e.section or 'Combined' }} <span class="text-muted">- {{ e.body.split('\n')[1] if e.body.count('\n') else e.body[:80] }}</span></div>
+      <div class="d-flex gap-1">
+        <a class="btn btn-outline-secondary btn-sm" href="{{ url_for('logbook.entry_detail', entry_id=e.id) }}"><i class="bi bi-pencil"></i></a>
+        <a class="btn btn-outline-primary btn-sm" target="_blank" href="{{ url_for('logbook.entry_print', entry_id=e.id) }}"><i class="bi bi-printer"></i> Sticker</a>
+      </div>
+    </div>
+    {% endfor %}
+  </div>
+  {% else %}
+  <p class="text-muted small mb-0">Nothing saved yet.</p>
+  {% endif %}
+</div>
+{% endblock %}
+{% block scripts %}
+<script>
+function lbCopy(btn) {
+  var ta = btn.closest('form').querySelector('textarea');
+  var done = function () { var t = btn.innerHTML; btn.innerHTML = '<i class="bi bi-check2"></i> Copied'; setTimeout(function () { btn.innerHTML = t; }, 1500); };
+  if (navigator.clipboard && window.isSecureContext) { navigator.clipboard.writeText(ta.value).then(done); }
+  else { ta.select(); document.execCommand('copy'); done(); }
+}
+</script>
+{% endblock %}
