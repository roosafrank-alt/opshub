+        <span class="small text-truncate flex-grow-1">{% if e.project_code %}<code>{{ e.project_code }}</code> {% endif %}{{ e.section or (project_type_labels.get(e.project_type) or 'Combined') }}</span>
+      </summary>
+      <div class="px-3 pb-2">
+        <div class="lb-body">{{ e.body }}</div>
+        <div class="d-flex gap-2 mt-2">
+          <a class="btn btn-outline-secondary btn-sm" href="{{ url_for('logbook.entry_detail', entry_id=e.id) }}"><i class="bi bi-pencil"></i> Open</a>
+          <a class="btn btn-outline-primary btn-sm" target="_blank" href="{{ url_for('logbook.entry_print', entry_id=e.id) }}"><i class="bi bi-printer"></i> Sticker</a>
+          {% if e.project_id %}<a class="btn btn-outline-secondary btn-sm" href="{{ url_for('project_detail', project_id=e.project_id) }}"><i class="bi bi-clipboard-check"></i> Project</a>{% endif %}
+        </div>
+      </div>
