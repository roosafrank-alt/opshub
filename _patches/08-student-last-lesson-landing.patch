 {% block content %}
 <div class="row justify-content-center">
 <div class="col-lg-6">
+{% if student and not student.is_station %}
+<div class="card p-3 mb-3">
+  <h5 class="mb-2"><i class="bi bi-airplane-engines"></i> Lessons &amp; Landings</h5>
+  <div class="row g-2 small mb-2">
+    <div class="col-6 col-md-3">
+      <div class="text-muted text-uppercase fw-bold" style="font-size:.65rem;">Last lesson</div>
+      {% if activity and activity.last_lesson %}{% set l = activity.last_lesson %}
+      <a href="{{ url_for('flight.log_detail', flight_id=l.id) }}" class="fw-bold text-decoration-none">{{ l.flight_date|usdate }}</a>
+      <div class="text-muted">{{ l.plane_tag }} &middot; {{ l.cfi_name or 'solo' }}</div>
+      {% else %}<div class="text-muted">None yet</div>{% endif %}
+    </div>
+    <div class="col-6 col-md-3">
+      <div class="text-muted text-uppercase fw-bold" style="font-size:.65rem;">Last landing</div>
+      {% if activity and activity.last_landing %}{% set l = activity.last_landing %}
+      <a href="{{ url_for('flight.log_detail', flight_id=l.id) }}" class="fw-bold text-decoration-none">{{ l.flight_date|usdate }}</a>
+      <div class="text-muted">{{ l.landings_total }} landing{{ 's' if l.landings_total != 1 }}{% if l.days_ago is not none %} &middot; {{ 'today' if l.days_ago == 0 else l.days_ago ~ 'd ago' }}{% endif %}</div>
+      {% else %}<div class="text-muted">None logged</div>{% endif %}
+    </div>
+    <div class="col-6 col-md-3">
+      <div class="text-muted text-uppercase fw-bold" style="font-size:.65rem;">Last 90 days</div>
+      <div class="fw-bold">{{ activity.landings_90 if activity else 0 }} landings</div>
+      <div class="text-muted">{{ activity.night_fs_90 if activity else 0 }} night full-stop</div>
+    </div>
+    <div class="col-6 col-md-3">
+      <div class="text-muted text-uppercase fw-bold" style="font-size:.65rem;">Solo currency</div>
+      {% if solo_currency and solo_currency.ok %}<span class="badge bg-success">Current</span><div class="text-muted">{{ solo_currency.interval_days - solo_currency.days_since }}d left</div>
+      {% elif solo_currency and solo_currency.last_dual_date %}<span class="badge bg-danger">Checkout due</span><div class="text-muted">{{ solo_currency.days_since }}d since dual</div>
+      {% else %}<span class="badge bg-secondary">No dual yet</span>{% endif %}
+    </div>
+  </div>
+  {% if recent_flights %}
+  <div class="table-responsive">
+    <table class="table table-sm align-middle mb-0 table-stack small">
+      <thead class="table-light"><tr><th>Date</th><th>Plane</th><th>With</th><th>Day ldg</th><th>Night ldg</th></tr></thead>
+      <tbody>
+        {% for f in recent_flights %}
+        <tr role="button" onclick="window.location='{{ url_for('flight.log_detail', flight_id=f.id) }}'">
+          <td data-label="Date">{{ f.flight_date|usdate }}</td>
+          <td data-label="Plane">{{ f.plane_tag }}</td>
+          <td data-label="With">{{ f.cfi_name or 'Solo' }}</td>
+          <td data-label="Day ldg">{% if f.day_landings_fs is not none or f.day_landings_tg is not none %}{{ f.day_landings_fs or 0 }} FS / {{ f.day_landings_tg or 0 }} TG{% else %}<span class="text-muted">-</span>{% endif %}</td>
+          <td data-label="Night ldg">{% if f.night_landings_fs is not none or f.night_landings_tg is not none %}{{ f.night_landings_fs or 0 }} FS / {{ f.night_landings_tg or 0 }} TG{% else %}<span class="text-muted">-</span>{% endif %}</td>
+        </tr>
+        {% endfor %}
+      </tbody>
+    </table>
+  </div>
+  <div class="form-text">Last 10 flights. Tap one to open it. Landings come from what's entered when the flight is logged or ended.</div>
+  {% endif %}
+</div>
+{% endif %}
 <div class="card p-4">
