+{#- Medicals (students + CFIs) expired or running out within 30 days -
+   flight._medical_alerts. Expired CFIs can't be booked or start a flight;
+   expired students can fly dual but not solo. #}
+{% if medical_alerts %}
+<div class="alert {{ 'alert-danger border-danger' if medical_alerts|selectattr('med.ok', 'false')|list else 'alert-warning border-warning' }} border-2 mb-3">
+  <h6 class="alert-heading mb-1"><i class="bi bi-heart-pulse"></i> Medicals Needing Attention</h6>
+  {% for m in medical_alerts %}
+  <div class="small py-1 {{ 'border-top' if not loop.first }} d-flex justify-content-between align-items-center flex-wrap gap-1">
+    <span><strong>{{ m.name }}</strong> <span class="text-muted">({{ m.kind }}, {{ m.med.label }})</span> &middot;
+      {% if m.med.ok is false %}<span class="badge bg-danger">Expired {{ m.med.expires|usdate }}</span> {{ "can't fly" if m.kind == 'CFI' else 'dual only - no solo' }}
+      {% else %}<span class="badge bg-warning text-dark">Expires {{ m.med.expires|usdate }}</span> {{ m.med.days_left }} day{{ 's' if m.med.days_left != 1 }} left{% endif %}</span>
+    <a href="{{ m.url }}" class="btn btn-sm btn-outline-dark">Update</a>
+  </div>
+  {% endfor %}
+</div>
+{% endif %}
