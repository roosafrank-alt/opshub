 {% block scripts %}
 <script>
+// Keeps the sticky schedule toolbar tucked right under the navbar (whose
+// height varies - wrapped items, open phone menu), and adds a shadow once
+// the toolbar is actually floating over scrolled content.
+(function () {
+  var nav = document.querySelector('nav.navbar.sticky-top');
+  function setNavH() {
+    if (nav) document.documentElement.style.setProperty('--flight-nav-h', nav.offsetHeight + 'px');
+  }
+  setNavH();
+  window.addEventListener('resize', setNavH);
+  if (nav && window.ResizeObserver) new ResizeObserver(setNavH).observe(nav);
+  function markStuck() {
+    var tb = document.querySelector('.schedule-toolbar');
+    if (!tb) return;
+    var navH = nav ? nav.offsetHeight : 0;
+    tb.classList.toggle('is-stuck', window.scrollY > 0 && tb.getBoundingClientRect().top <= navH + 1);
+  }
+  window.addEventListener('scroll', markStuck, { passive: true });
+  document.addEventListener('DOMContentLoaded', markStuck);
+})();
 var START_EARLY_BUFFER_MIN = {{ start_early_buffer_min|default(30) }};
