diff --git a/templates/flight/schedule.html b/templates/flight/schedule.html
index 91d1576..d3a2600 100644
--- a/templates/flight/schedule.html
+++ b/templates/flight/schedule.html
@@ -60,6 +60,25 @@
     .schedule-toolbar .btn-group { flex-wrap: nowrap; overflow-x: auto; max-width: 100%; }
     .schedule-toolbar .form-label { font-size: .7rem; }
   }
+  /* Month / quarter / year grid: the day number sits in its own header
+     strip, and blocks start below it so they never cover the date. Blocks
+     are one tidy line (time + plane) plus the people line. */
+  .calendar-day-cell { padding: .25rem !important; }
+  .calendar-day-head { border-bottom: 1px solid #e9ecef; margin-bottom: .3rem; padding-bottom: .15rem; }
+  .calendar-day-cell .schedule-block { line-height: 1.25; padding-top: 2px; padding-bottom: 2px; font-size: .75rem; }
+  .calendar-day-cell .schedule-block .sb-time { font-weight: 700; }
+  .calendar-day-cell .schedule-block .sb-line2 { opacity: .9; font-size: .7rem; }
+  .calendar-day-cell .schedule-block-active { animation: schedule-block-pulse-inset 1.8s ease-in-out infinite; }
+  @keyframes schedule-block-pulse-inset {
+    0%, 100% { box-shadow: inset 0 0 0 1px rgba(255,193,7,0.5); }
+    50% { box-shadow: inset 0 0 0 3px rgba(255,193,7,1); }
+  }
+  .calendar-more-link { display: block; font-size: .7rem; font-weight: 600; text-decoration: none; padding: 0 .25rem; }
+  .calendar-more-link:hover { text-decoration: underline; }
+  @media (max-width: 575.98px) {
+    .calendar-day-cell .schedule-block .sb-line2 { display: none; }
+    .calendar-day-cell .schedule-block { font-size: .62rem; padding-left: 2px !important; padding-right: 2px !important; }
+  }
   .calendar-day-add { border-radius: 3px; padding: 1px 3px; margin: -1px -3px; transition: background-color .15s ease; }
   .calendar-day-add:hover { background-color: rgba(13,110,253,.12); }
   .calendar-day-add-icon { font-size: .7rem; color: #adb5bd; margin-left: auto; }
