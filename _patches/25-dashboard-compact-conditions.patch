--- a/templates/flight/dashboard.html
+++ b/templates/flight/dashboard.html
@@ -12,6 +12,15 @@
   @media (max-width: 767px) { .wx-bg-icon { font-size: 5rem; } }
   .wx-tile .wx-subtle { color: rgba(255,255,255,.8); }
   .wx-tile .wx-hr { border-color: rgba(255,255,255,.3); }
+  /* Compact conditions strip (see "Conditions quick view" in _dashboard_live.html) */
+  .wx-compact .wx-bg-icon { font-size: 4rem; top: -0.6rem; right: -0.2rem; }
+  .wx-strip { display: flex; flex-wrap: wrap; align-items: center; column-gap: 1.1rem; row-gap: .2rem; font-size: .88rem; }
+  .wx-strip-main { display: flex; align-items: center; gap: .4rem; }
+  .wx-strip-main > .bi { font-size: 1.4rem; }
+  .wx-strip-temp { font-size: 1.5rem; font-weight: 700; line-height: 1; }
+  .wx-strip-item { white-space: nowrap; }
+  .wx-metar { font-size: .74rem; margin-top: .2rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+  @media (max-width: 575.98px) { .wx-strip { column-gap: .8rem; font-size: .82rem; } .wx-metar { white-space: normal; } }
 
   /* Clear - warm sun glow low in one corner over an open-sky gradient. */
   .wx-tile.wx-clear {
