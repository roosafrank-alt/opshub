--- a/templates/flight/_dashboard_live.html
+++ b/templates/flight/_dashboard_live.html
@@ -140,6 +140,123 @@
 {% endmacro %}
 
 {#
+  Conditions quick view - weather and NOTAMs side by side near the top
+  (right under any in-progress / next-lesson banners, above the schedule)
+  so a CFI sees go/no-go info at a glance before scrolling. Weather is one
+  compact strip; NOTAMs show a count and open into the list on click (the
+  same remembered dash-collapse toggle the schedule sections use).
+  Sunrise/sunset/civil twilight now live in the header time box
+  (dashboard.html), so they're not repeated here.
+#}
+{% if cfi and (dashboard_wx or dashboard_notams) %}
+<div class="row g-2 mb-3 dash-conditions">
+  {% if dashboard_wx %}
+  {% set c = dashboard_wx.conditions %}
+  {% set wxcat = c.wx_category if c else 'unknown' %}
+  {% set is_day = c.is_day if c and c.is_day is not none else true %}
+  {% set wx_icons = {
+    'clear':   ('bi-sun-fill', 'bi-moon-stars-fill'),
+    'cloudy':  ('bi-cloud-sun-fill', 'bi-cloud-moon-fill'),
+    'fog':     ('bi-cloud-fog2-fill', 'bi-cloud-fog2-fill'),
+    'rain':    ('bi-cloud-rain-heavy-fill', 'bi-cloud-rain-heavy-fill'),
+    'snow':    ('bi-cloud-snow-fill', 'bi-cloud-snow-fill'),
+    'storm':   ('bi-cloud-lightning-rain-fill', 'bi-cloud-lightning-rain-fill'),
+    'unknown': ('bi-question-circle', 'bi-question-circle'),
+  } %}
+  {% set wxicon = (wx_icons[wxcat] if wxcat in wx_icons else wx_icons['unknown'])[0 if is_day else 1] %}
+  <div class="{{ 'col-lg-8' if dashboard_notams else 'col-12' }}">
+  <div class="card px-3 py-2 h-100 wx-tile wx-compact wx-{{ wxcat }} {{ 'wx-night' if not is_day }}">
+    <i class="bi {{ wxicon }} wx-bg-icon" aria-hidden="true"></i>
+    <div class="wx-content">
+    {% if c %}
+    <div class="wx-strip">
+      <div class="wx-strip-main" title="{{ c.weather_label }}">
+        <i class="bi {{ wxicon }}"></i>
+        <span class="wx-strip-temp">{{ '%.0f'|format(c.temp_f) + '°' if c.temp_f is not none else '-' }}</span>
+        <span class="small wx-subtle">{% if c.feels_like_f is not none %}feels {{ '%.0f'|format(c.feels_like_f) }}&deg; &middot; {% endif %}{{ c.weather_label }}</span>
+      </div>
+      <div class="wx-strip-item">
+        <span class="wx-subtle">Wind</span>
+        {% if c.wind_dir_deg is not none and c.wind_mph %}
+        <i class="bi bi-arrow-up wx-wind-arrow" style="transform: rotate({{ (c.wind_dir_deg|float + 180) % 360 }}deg); display:inline-block;" title="Wind from {{ c.wind_dir_deg|int }}°"></i>
+        {% endif %}
+        <strong>{{ '%.0f'|format(c.wind_mph) if c.wind_mph is not none else '-' }}</strong>{% if c.wind_mph is not none %} mph{% endif %}
+        {% if c.wind_dir_deg is not none %}<span class="wx-subtle">{{ c.wind_dir_deg|int }}&deg; {{ _wind_compass(c.wind_dir_deg) }}</span>{% endif %}
+        {% if c.wind_gusts_mph %}<span class="wx-subtle">G{{ '%.0f'|format(c.wind_gusts_mph) }}</span>{% endif %}
+      </div>
+      <div class="wx-strip-item"><span class="wx-subtle">Clouds</span> <strong>{{ c.cloud_cover_pct|int if c.cloud_cover_pct is not none else '-' }}%</strong></div>
+      <div class="wx-strip-item"><span class="wx-subtle">Vis</span> <strong>{{ '%.1f'|format(c.visibility_miles) if c.visibility_miles is not none else '-' }}</strong>{% if c.visibility_miles is not none %} mi{% endif %}</div>
+      <div class="wx-strip-item"><span class="wx-subtle">Precip</span> <strong>{{ '%.2f'|format(c.precipitation_in) if c.precipitation_in is not none else '-' }}</strong>{% if c.precipitation_in is not none %} in{% endif %}</div>
+    </div>
+    {% else %}
+    <p class="small mb-0 wx-subtle"><i class="bi bi-cloud-sun"></i> {{ dashboard_wx.error or 'Weather unavailable right now.' }}</p>
+    {% endif %}
+    {% if dashboard_wx.metar and dashboard_wx.metar.raw_text %}
+    <div class="wx-metar font-monospace wx-subtle" title="{{ dashboard_wx.metar.raw_text }}">{{ dashboard_wx.metar.raw_text }}</div>
+    {% endif %}
+    </div>
+  </div>
+  </div>
+  {% endif %}
+
+  {% if dashboard_notams %}
+  {% set notam_list = dashboard_notams.notams if dashboard_notams.configured and not dashboard_notams.error else [] %}
+  <div class="{{ 'col-lg-4' if dashboard_wx else 'col-12' }}">
+  <div class="card px-3 py-2 h-100">
+    <div class="d-flex justify-content-between align-items-center gap-2">
+      <button type="button" class="dash-collapse-toggle d-flex align-items-center gap-2 border-0 bg-transparent text-start p-0 flex-grow-1" data-collapse="notams">
+        <h6 class="mb-0"><i class="bi bi-exclamation-diamond"></i> NOTAMs</h6>
+        {% if not dashboard_notams.configured or dashboard_notams.error %}
+        <span class="badge bg-secondary">Not loaded</span>
+        {% elif notam_list %}
+        <span class="badge bg-warning text-dark">{{ notam_list|length }} active</span>
+        {% else %}
+        <span class="badge bg-success">None</span>
+        {% endif %}
+        <i class="bi bi-chevron-right dash-collapse-chevron ms-auto"></i>
+      </button>
+      <a href="{{ dashboard_notams.search_url }}" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm py-0" title="FAA NOTAM Search">FAA <i class="bi bi-box-arrow-up-right"></i></a>
+    </div>
+    <div class="small text-muted">N89 + 25nm</div>
+    <div class="dash-collapse-body mt-2" data-collapse-body="notams" hidden>
+    {% if not dashboard_notams.configured %}
+    <p class="text-muted small mb-0">
+      NOTAM pulling isn't set up yet - the FAA's NOTAM API needs a free client_id/client_secret
+      (register at <a href="https://api.faa.gov" target="_blank" rel="noopener">api.faa.gov</a> and fill them
+      into <code>notams.py</code>). Until then, use the FAA link to check N89 and nearby airports by hand.
+    </p>
+    {% elif dashboard_notams.error %}
+    <p class="text-muted small mb-0">{{ dashboard_notams.error }} Use the FAA link in the meantime.</p>
+    {% elif notam_list %}
+    <div class="table-responsive" style="max-height:260px; overflow-y:auto;">
+      <table class="table table-sm align-middle mb-0 table-stack">
+        <thead class="table-light"><tr><th>Airport</th><th>NOTAM #</th><th>Effective</th><th></th></tr></thead>
+        <tbody>
+          {% for n in notam_list %}
+          <tr>
+            <td class="stack-full" data-label="Airport">
+              <strong>{{ n.icao }}</strong>
+              {% if n.airport_label %}<div class="text-muted small">{{ n.airport_label }}{% if n.distance_nm is not none %} &middot; {{ n.distance_nm }}nm{% endif %}</div>{% endif %}
+            </td>
+            <td data-label="NOTAM #"><code>{{ n.number }}</code>{% if n.notam_type %} <span class="badge bg-secondary">{{ n.notam_type }}</span>{% endif %}</td>
+            <td class="stack-full" data-label="Effective"><small class="text-muted">{{ n.effective_start or '-' }}{% if n.effective_end %} &ndash; {{ n.effective_end }}{% endif %}</small></td>
+            <td data-label=""><a href="{{ dashboard_notams.search_url }}" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">Read <i class="bi bi-box-arrow-up-right"></i></a></td>
+          </tr>
+          {% endfor %}
+        </tbody>
+      </table>
+    </div>
+    {% else %}
+    <p class="text-muted small mb-0">No active NOTAMs for N89 or the surrounding 25nm right now.</p>
+    {% endif %}
+    </div>
+  </div>
+  </div>
+  {% endif %}
+</div>
+{% endif %}
+
+{#
   Both sections below are collapsed by default (click the header to open) so
   the dashboard loads compact instead of dumping every flight on the page.
   Once opened, a section (or an expanded chip) stays open across the
@@ -207,126 +324,6 @@
   </div>
 </div>
 
