 (function () {
+  // Student search: filters the Student list as you type. Rebuilds the
+  // <select>'s options (hiding <option>s doesn't work on iPhone/iPad
+  // Safari). The placeholder, Guest / Intro and the currently picked
+  // student always stay; a single match is picked for you; Enter picks
+  // the first match.
+  var box = document.getElementById('student-search');
+  var sel = document.getElementById('student-select');
+  if (!box || !sel) { return; }
+  var all = Array.prototype.map.call(sel.options, function (o) {
+    return { value: o.value, text: o.text, disabled: o.disabled, keep: !o.value || o.value === sel.dataset.guestId };
+  });
+  function norm(t) { return (t || '').toLowerCase().replace(/\s+/g, ' ').trim(); }
+  function apply(pickFirst) {
+    var q = norm(box.value);
+    var current = sel.value;
+    var matches = [];
+    sel.innerHTML = '';
+    all.forEach(function (o) {
+      var hit = !q || norm(o.text).indexOf(q) !== -1 || norm(o.text).split(' ').some(function (w) { return w.indexOf(q) === 0; });
+      if (!(o.keep || hit || o.value === current)) { return; }
+      var opt = new Option(o.text, o.value);
+      opt.disabled = o.disabled;
+      sel.add(opt);
+      if (!o.keep && hit && q) { matches.push(o.value); }
+    });
+    if (q && (matches.length === 1 || (pickFirst && matches.length))) { sel.value = matches[0]; }
+    else { sel.value = current; if (sel.value !== current) { sel.value = ''; } }
+    sel.dispatchEvent(new Event('change'));
+    box.classList.toggle('is-invalid', !!q && !matches.length);
+  }
+  box.addEventListener('input', function () { apply(false); });
+  box.addEventListener('keydown', function (e) {
+    if (e.key === 'Enter') { e.preventDefault(); apply(true); }
+  });
+})();
