--- a/templates/flight/schedule.html
+++ b/templates/flight/schedule.html
@@ -27,6 +27,18 @@
      Flight" with that date pre-filled, instead of the generic toolbar
      button with no date picked yet. Avoids :has() for broader browser
      support (this renders on a kiosk Pi browser too). */
+  /* List / custom-range tables: a heavy divider where a new day starts,
+     and past days greyed out so upcoming flights stand out. */
+  tr.schedule-day-break:not(:first-child) > td { border-top: 3px solid #6c757d !important; }
+  tr.schedule-row-past > td { background-color: #f1f3f5 !important; color: #8a9199 !important; }
+  tr.schedule-row-past { opacity: 0.7; }
+  tr.schedule-row-past .badge { filter: grayscale(60%); }
+  tr.schedule-row-today > td { background-color: #fffbea; }
+  @media (max-width: 575.98px) {
+    /* Stacked-card layout on phones: a gap + bar above each new day. */
+    .table-stack tbody tr.schedule-day-break:not(:first-child) { margin-top: 1.1rem; border-top: 4px solid #6c757d; }
+    .table-stack tbody tr.schedule-row-past { background: #f1f3f5; }
+  }
   .calendar-day-add { border-radius: 3px; padding: 1px 3px; margin: -1px -3px; transition: background-color .15s ease; }
