diff --git a/app.py b/app.py
index ed50d6a..601f3ea 100644
--- a/app.py
+++ b/app.py
@@ -84,6 +84,18 @@ def usdate(value, show_time=False):
 app.jinja_env.filters["usdate"] = usdate
 
 
+def first_name(value):
+    """'Kate Smith' -> 'Kate' - instructors are shown by first name on the
+    flight dashboard and schedule blocks (students keep their full name)."""
+    if not value:
+        return value
+    parts = str(value).strip().split()
+    return parts[0] if parts else value
+
+
+app.jinja_env.filters["first_name"] = first_name
+
+
 _WIND_COMPASS_POINTS = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE",
                         "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]
 
