+{% block scripts %}
+<script>
+(function () {
+  var input = document.getElementById('color-input');
+  var swatches = document.querySelectorAll('#color-swatches .color-swatch');
+  var preview = document.getElementById('color-preview');
+  var previewSolo = document.getElementById('color-preview-solo');
+  // Same "neon" rule as flight.py _neon_color: same hue, full saturation, 55% lightness.
+  function neon(hex) {
+    var h = (hex || '#868e96').replace('#', '');
+    var r = parseInt(h.substr(0, 2), 16) / 255, g = parseInt(h.substr(2, 2), 16) / 255, b = parseInt(h.substr(4, 2), 16) / 255;
+    var max = Math.max(r, g, b), min = Math.min(r, g, b), d = max - min, hue = 0, l = (max + min) / 2;
+    var s = d === 0 ? 0 : d / (1 - Math.abs(2 * l - 1));
+    if (d !== 0) {
+      if (max === r) hue = ((g - b) / d) % 6; else if (max === g) hue = (b - r) / d + 2; else hue = (r - g) / d + 4;
+      hue *= 60; if (hue < 0) hue += 360;
+    }
+    if (s < 0.08) hue = 90;
+    return 'hsl(' + hue + ', 100%, 55%)';
+  }
+  function paint(hex) {
+    preview.style.background = hex || '#868e96';
+    previewSolo.style.background = neon(hex);
+    previewSolo.style.color = '#111';
+    previewSolo.style.boxShadow = 'inset 0 0 6px rgba(255,255,255,.75)';
+  }
+  paint(input.value);
+  swatches.forEach(function (sw) {
+    sw.addEventListener('click', function () {
+      if (sw.classList.contains('color-swatch-taken')) return;
+      input.value = sw.getAttribute('data-color');
+      swatches.forEach(function (s) { s.style.border = s.getAttribute('data-color') ? '3px solid transparent' : '3px dashed #adb5bd'; });
+      sw.style.border = sw.getAttribute('data-color') ? '3px solid #212529' : '3px dashed #212529';
+      paint(input.value);
+    });
+  });
+})();
+</script>
+{% endblock %}
