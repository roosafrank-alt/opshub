 (function () {
+  // Presets (Lesson 1.5 hr / Intro Flight 1 hr): set the duration, swap
+  // the quick-pick grid (on the hour for intro flights), and start the
+  // notes with "Intro flight" for an intro (taken back off if you switch
+  // back to Lesson and hadn't changed it). The preset that matches the
+  // form's current duration/notes is highlighted on load (e.g. editing an
+  // intro flight).
+  var presets = document.querySelectorAll('.preset-btn');
+  if (!presets.length) { return; }
+  var duration = document.querySelector('input[name="duration_hours"]');
+  var notes = document.querySelector('textarea[name="notes"]');
+  var introTimes = document.getElementById('quick-times-intro');
+  var lessonTimes = document.getElementById('quick-times-lesson');
+  var label = document.getElementById('quick-pick-label');
+  var INTRO = 'Intro flight';
+  function show(preset) {
+    presets.forEach(function (b) {
+      var on = b.dataset.preset === preset;
+      b.classList.toggle('btn-secondary', on);
+      b.classList.toggle('btn-outline-secondary', !on);
+    });
+    if (introTimes && lessonTimes) {
+      introTimes.classList.toggle('d-none', preset !== 'intro');
+      lessonTimes.classList.toggle('d-none', preset === 'intro');
+    }
+    if (label) { label.textContent = preset === 'intro' ? '(1-hr intro blocks)' : '(1.5-hr blocks)'; }
+  }
+  function isIntroNotes() { return notes && notes.value.trim().toLowerCase().indexOf(INTRO.toLowerCase()) === 0; }
+  presets.forEach(function (b) {
+    b.addEventListener('click', function () {
+      if (duration) { duration.value = b.dataset.duration; }
+      if (notes) {
+        if (b.dataset.preset === 'intro' && !isIntroNotes()) {
+          notes.value = notes.value.trim() ? INTRO + ' - ' + notes.value.trim() : INTRO;
+        } else if (b.dataset.preset === 'lesson' && isIntroNotes()) {
+          notes.value = notes.value.trim().slice(INTRO.length).replace(/^\s*-\s*/, '');
+        }
+      }
+      show(b.dataset.preset);
+    });
+  });
+  var d = duration ? parseFloat(duration.value) : NaN;
+  if (isIntroNotes() || d === 1) { show(isIntroNotes() ? 'intro' : ''); }
+  else if (d === 1.5 || !duration || !duration.value) { show('lesson'); }
+  else { show(''); }
+})();
